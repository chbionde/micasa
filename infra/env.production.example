# MiCasa — modelo do .env de produção.
#
#   cp infra/env.production.example api/.env
#   cd api && php artisan key:generate
#
# NUNCA versione o api/.env preenchido: ele carrega APP_KEY e credenciais de
# e-mail. O .gitignore já bloqueia, mas a regra é sua, não do arquivo.

APP_NAME=MiCasa
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://micasa-bionde.duckdns.org

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Origem única (ADR-020): front e API no mesmo hostname. FRONTEND_URL alimenta
# o link de redefinição de senha e a lista de origens do CORS; o domínio
# stateful é o que autoriza o Sanctum a autenticar por cookie de sessão.
FRONTEND_URL=https://micasa-bionde.duckdns.org
SANCTUM_STATEFUL_DOMAINS=micasa-bionde.duckdns.org

# daily + warning: com 1 GB de RAM e 46 GB de disco, log em nível debug enche
# o disco e é o que mais tende a vazar dado sensível.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# SQLite com WAL (ADR-003). Ver comentário em api/config/database.php:
#   WAL          — leitura concorrente com escrita; sem ele, a fila trava a web
#   busy_timeout — 5s de espera antes de desistir, em vez de erro imediato
#   NORMAL       — fsync no checkpoint em vez de a cada commit; com WAL, é o
#                  ajuste padrão recomendado e o ganho é grande em disco lento
DB_CONNECTION=sqlite
DB_JOURNAL_MODE=WAL
DB_BUSY_TIMEOUT=5000
DB_SYNCHRONOUS=NORMAL

# secure_cookie exige HTTPS — só funciona depois do certbot.
# SESSION_DOMAIN fica vazio de propósito: em origem única o cookie é do host
# atual, e preencher isto é a receita para "login não persiste".
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# E-mail transacional (ADR-004): usado pelo "esqueci minha senha".
#
# Com MAIL_MAILER=log nada é enviado: o LogTransport do Laravel grava a
# mensagem inteira no log, em nível DEBUG. Só que o LOG_LEVEL acima é `warning`
# — o Monolog descarta a linha antes de escrever. Nesta configuração o link de
# redefinição não aparece em lugar nenhum, e o "esqueci minha senha" parece
# quebrado sem que nada tenha quebrado.
#
# Para capturar o link enquanto não há SMTP, baixe o nível por alguns minutos:
#   sed -i 's/^LOG_LEVEL=warning/LOG_LEVEL=debug/' api/.env
#   cd api && php artisan config:cache && sudo systemctl reload php8.4-fpm
#   grep -oE 'https://[^ ]+/redefinir-senha/[A-Za-z0-9]+' storage/logs/laravel-*.log
#
# E volte para `warning` logo depois: em debug o log guarda o corpo dos e-mails,
# incluindo tokens de redefinição válidos.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=nao-responda@micasa-bionde.duckdns.org
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Backup diario cifrado (ADR-009 + emenda de 2026-08-10) — infra/backup.sh
# ---------------------------------------------------------------------------
#
# BACKUP_AGE_RECIPIENT e a chave PUBLICA do age. Ela NAO e segredo: serve so para
# cifrar, e nao decifra nada. Pode aparecer aqui, num commit ou num chat.
#
# A chave PRIVADA correspondente NUNCA pode existir nesta maquina. Esse e o ponto
# inteiro da emenda do ADR-009: quem invadir a VPS nao decifra backup algum, nem
# os antigos. O backup.sh se recusa a rodar se achar AGE-SECRET-KEY neste arquivo.
#
# Ela e o unico segredo INSUBSTITUIVEL do projeto — perdida, todo backup no B2 vira
# lixo cifrado para sempre. Por isso precisa de copia FORA da maquina do dev.
BACKUP_AGE_RECIPIENT=

# Interruptor de homem morto. O backup.sh chama esta URL quando termina BEM, e um
# observador FORA desta maquina alarma quando a chamada nao chega no horario.
#
# O sentido invertido e proposital: um alerta enviado PELO script nao detecta o
# script que nao rodou — cron parado, disco cheio, VPS recuperada por ociosidade.
# Esses sao os modos de falha mais provaveis, e sao invisiveis para o proprio script.
#
# Vazio = sem vigia. O backup roda, e falha em silencio.
# A URL e RECRIAVEL (gera-se outra no painel do servico): vive aqui e so aqui.
BACKUP_PING_URL=

# Credenciais do Backblaze B2. Chave Write Only, restrita ao bucket micasa-backups
# (endpoint s3.us-east-005.backblazeb2.com). RECRIAVEIS pelo console da Backblaze:
# vivem no servidor e so nele, sem copia externa — o oposto da chave age.
#
# Write Only concede apenas `writeFiles`. Consequencias, ja embutidas no desenho:
#   - a retencao de 30 dias e Lifecycle Rule do bucket, porque o script nao apaga
#   - a verificacao do upload e pelo codigo de saida, nao lendo o arquivo de volta
#   - restauracao usa a chave Read Only, na maquina do dev, NUNCA a partir daqui
#
# Confira com:  ./infra/backup.sh --testar
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_ID=
